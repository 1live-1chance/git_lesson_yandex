CREATE TABLE coffee (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    название_сорта TEXT NOT NULL,
    степень_обжарки TEXT NOT NULL,
    тип TEXT NOT NULL,
    описание_вкуса TEXT,
    цена REAL NOT NULL,
    объем_упаковки REAL NOT NULL
);

INSERT INTO coffee (название_сорта, степень_обжарки, тип, описание_вкуса, цена, объем_упаковки) VALUES
